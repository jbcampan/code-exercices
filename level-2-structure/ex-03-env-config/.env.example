# Database Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Required — hostname or IP of the database server
DB_HOST=

# Optional — port number (default: 5432)
DB_PORT=5432

# Required — name of the target database
DB_NAME=

# Optional — logging verbosity: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO
